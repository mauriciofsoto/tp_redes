<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Copiamos config.json y la carpeta pública junto al ejecutable.
       Así AppContext.BaseDirectory encuentra todo en bin/.../net10.0/. -->
  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="publico/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
